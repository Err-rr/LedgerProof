RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Neon Postgres connection string. Required by the API (api/deps.py) and by
# Alembic (alembic/env.py) to run migrations. Not required to run the test
# suite -- tests override the repository with an in-memory fake.
DATABASE_URL=

# S3 bucket that POST /runs uploads source files into. Not required to run
# the test suite -- tests override storage with an in-memory fake.
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# Comma-separated origins allowed to call this API directly via CORS.
# Irrelevant to web/'s normal setup (its route handlers call this API
# server-to-server, never from the browser), but matters if anything calls
# this API straight from a browser -- e.g. a debugging session or a
# deployment that doesn't proxy through web/. Defaults to the Next.js dev
# server's default origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
